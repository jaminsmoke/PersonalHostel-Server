# Recorte de borde Identity (sidecar). No pegar en el Caddy vanilla del host.
# Lo importa `Caddyfile`. Clave {client_ip}: el peer TCP es Docker/loopback.

(identity_edge_errors) {
	handle_errors {
		@limited expression `{err.status_code} == 429`
		handle @limited {
			header Content-Type application/json
			header Retry-After 60
			header Cache-Control no-store
			respond `{"code":"identity.rate_limited","detail":"Demasiadas peticiones. Inténtalo de nuevo más tarde"}` 429
		}
	}
}

(identity_edge_camareros) {
	request_body {
		max_size 5MB
	}
	rate_limit {
		zone cam_login {
			match {
				path /v1/auth/login
			}
			key {client_ip}
			events 20
			window 1m
			ipv6_prefix 64
		}
		zone cam_registro {
			match {
				path /v1/camareros/registro
			}
			key {client_ip}
			events 10
			window 1m
			ipv6_prefix 64
		}
		zone cam_refresh {
			match {
				path /v1/auth/refresh
			}
			key {client_ip}
			events 20
			window 1m
			ipv6_prefix 64
		}
	}
}

(identity_edge_negocio) {
	request_body {
		max_size 5MB
	}
	rate_limit {
		zone neg_login {
			match {
				path /v1/auth/negocio/login
			}
			key {client_ip}
			events 20
			window 1m
			ipv6_prefix 64
		}
		zone neg_registro {
			match {
				path /v1/auth/negocio/registro
			}
			key {client_ip}
			events 10
			window 1m
			ipv6_prefix 64
		}
		zone neg_refresh {
			match {
				path /v1/auth/negocio/refresh
			}
			key {client_ip}
			events 20
			window 1m
