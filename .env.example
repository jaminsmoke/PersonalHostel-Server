POSTGRES_USER=hosteleria
POSTGRES_PASSWORD=devlocal
POSTGRES_DB=identity
IDENTITY_PORT=8080
NEGOCIO_PORT=8082
# Secretos compartidos entre los dos servicios. En producción ponlos SIEMPRE
# (valores aleatorios, nunca los defaults de desarrollo).
# Access JWT (horas). Si se omite, 12 h. SESSION_TTL_DAYS sigue como fallback
# (días × 24) para .env antiguos.
# SESSION_ACCESS_HOURS=12
# SESSION_REFRESH_DAYS=30
SESSION_SECRET=
QR_SIGNING_KEY=
# Redis (cuotas). En local, si se omite, Compose usa 'devlocal'. En el VPS es
# obligatorio (check_production_secrets, ≥16, no el default).
# REDIS_PASSWORD=
EMAIL_PROVIDER=console
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=verified-sender@example.com
EMAIL_USE_TLS=true
# VPS (recomendado): https://web.camareros.siberia.solutions/invitaciones
# Fallback dev local: http://localhost:8084/invitaciones
INVITATION_URL_BASE=http://localhost:8084/invitaciones
INVITATION_TTL_HOURS=72
# Origen(es) de la web que consumen las APIs (separados por coma). En el VPS
# incluye los subdominios autorizados (web.negocio.*, web.camareros.*, …).
# VPS (recomendado): https://web.negocio.siberia.solutions,https://web.camareros.siberia.solutions,https://web.mesa.siberia.solutions
IDENTITY_WEB_ORIGIN=http://localhost:8083,http://localhost:8084,http://localhost:8085,https://web.negocio.siberia.solutions,https://web.camareros.siberia.solutions,https://web.mesa.siberia.solutions
# Base pública del servicio de negocio que consumen web-camareros (magic-link de
# invitaciones) y web-negocio (ficha y carta públicas por enlace). En el VPS: https://negocio.siberia.solutions
NEGOCIO_API_URL=http://localhost:8082
# Base pública de la web de negocios (la API añade /negocios/<slug> o /negocios/<slug>/carta).
# VPS (recomendado): https://web.negocio.siberia.solutions
WEB_NEGOCIO_URL_BASE=http://localhost:8083
# Base pública de la ficha del camarero (la API añade /camareros?qr=...).
# VPS (recomendado): https://web.camareros.siberia.solutions
FICHA_URL_BASE=http://localhost:8084
# Base pública de CFC (la API de tokens añadirá /m/<token>).
# VPS (recomendado): https://web.mesa.siberia.solutions
WEB_CFC_URL_BASE=http://localhost:8085
# Solo desarrollo/test. En el VPS debe ser false (default seguro de la app).
ALLOW_NON_REAL_DATA=true

# Backup externo opcional (Cloudflare R2 + restic). Mantener false hasta que
# bucket, token limitado y contraseña recuperable estén configurados.
OFFSITE_BACKUP_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESTIC_PASSWORD_FILE=/opt/identity/.restic-password

# --- Despliegue al VPS de staging (vía SSH, igual que dev pero en el VPS) ---
# Rellenar solo en el .env local (nunca en git). docker compose NO consume estas
# variables; las usa el script de despliegue para conectar por SSH como root.
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
# Clave de host ed25519 del VPS (pinned anti-MITM). Obtenerla con:
#   ssh-keyscan -t ed25519 <VPS_HOST>
VPS_HOST_KEY=
# Ruta de la clave privada SSH para el deploy (por defecto ~/.ssh/identity_vps).
VPS_SSH_KEY_PATH=
# Token de la API de Hostinger (developers.hostinger.com). Solo lectura de
# VPS y DNS. Solo en el .env local, nunca en git.
HOSTINGER_API_KEY=

# --- Observabilidad (staging/producción, docker-compose.observability.yml) ---
# Credenciales de Grafana (admin). Se expone por Caddy con basic_auth adicional.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Destinatario de las alertas (email). Usa el SMTP de EMAIL_* de arriba.
ALERTMANAGER_ROUTE_TO=

# --- Cuentas de prueba canónicas (seed) ---
# Usadas por scripts/seed_test_accounts.py. Passwords SOLO en el .env local
# (nunca en git). Emails en el dominio reservado example.com.
# Vía recomendada: apuntar a staging (subdominios HTTPS). Los defaults
# localhost quedan como fallback para experimentación local aislada (Docker
# deprecado; la verificación oficial es el VPS).
CAMAREROS_API_URL=http://localhost:8080
NEGOCIO_API_URL=http://localhost:8082
TEST_CAMARERO_EMAIL=camarero.test@example.com
TEST_CAMARERO_PASSWORD=
TEST_NEGOCIO_EMAIL=negocio.test@example.com
TEST_NEGOCIO_PASSWORD=
